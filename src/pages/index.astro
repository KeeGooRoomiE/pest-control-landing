---
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Categories from "../components/sections/Categories.astro";
import ProductCarousel from "../components/sections/ProductCarousel.astro";
import Services from "../components/sections/Services.astro";
import Brands from "../components/sections/Brands.astro";
import About from "../components/sections/About.astro";
import CTAForm from "../components/sections/CTAForm.astro";
import Footer from "../components/sections/Footer.astro";
import StructuredData from "../components/seo/StructuredData.astro";
---

<Layout>
  <StructuredData slot="head" />
  <Header />
  <main id="main" tabindex="-1" class="outline-none">
    <Hero />
    <Services />
    <Categories />
    <ProductCarousel />
    <Brands />
    <About />
    <CTAForm />
  </main>
  <Footer />
</Layout>
