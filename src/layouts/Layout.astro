---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ДезГарант — профессиональная дезинсекция и дератизация",
  description = "Профессиональные средства и услуги по борьбе с вредителями. Дезинсекция, дератизация, продажа профессиональной химии.",
} = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-white text-slate-800">
    <slot />
  </body>
</html>
