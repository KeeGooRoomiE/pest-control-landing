---
type Variant = "primary" | "secondary" | "outline" | "danger" | "light";
type Size = "md" | "lg";

interface Props {
  href?: string;
  type?: "button" | "submit";
  variant?: Variant;
  size?: Size;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  class: className = "",
  ...rest
} = Astro.props;

const variants: Record<Variant, string> = {
  primary:
    "bg-brand-green text-white shadow-lg shadow-brand-green/20 hover:-translate-y-0.5 hover:bg-brand-green-dark hover:shadow-xl hover:shadow-brand-green/25",
  secondary:
    "bg-white text-ink ring-1 ring-slate-200 hover:-translate-y-0.5 hover:text-brand-green hover:ring-brand-green/40",
  light:
    "bg-white text-brand-red shadow-lg shadow-black/15 hover:-translate-y-0.5 hover:bg-red-50 hover:shadow-xl",
  outline: "bg-transparent text-white border border-white/70 hover:bg-white/10",
  danger:
    "bg-brand-red text-white shadow-lg shadow-brand-red/20 hover:-translate-y-0.5 hover:bg-brand-red-dark hover:shadow-xl hover:shadow-brand-red/25",
};

const sizes: Record<Size, string> = {
  md: "px-5 py-2.5 text-sm",
  lg: "px-7 py-3.5 text-base",
};

const classes = [
  "inline-flex items-center justify-center gap-2 rounded-xl font-semibold transition-all duration-200 active:translate-y-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green",
  variants[variant],
  sizes[size],
  className,
].join(" ");

const Tag = href ? "a" : "button";
---

<Tag {...rest} class={classes} href={href} type={href ? undefined : type}>
  <slot />
</Tag>
