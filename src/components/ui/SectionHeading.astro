---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, subtitle, align = "left", class: className = "" } = Astro.props;
---

<div class:list={[align === "center" ? "mx-auto text-center" : "text-left", "max-w-3xl", className]}>
  {eyebrow && <p class="mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-brand-green">{eyebrow}</p>}
  <h2 class="text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl">{title}</h2>
  {subtitle && <p class="mt-4 text-lg leading-relaxed text-slate-600">{subtitle}</p>}
</div>
