---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, subtitle, align = "left", class: className = "" } = Astro.props;
---

<div class:list={[align === "center" ? "text-center" : "text-left", className]}>
  {eyebrow && <p class="mb-2 text-sm font-semibold uppercase tracking-wide text-brand-green">{eyebrow}</p>}
  <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">{title}</h2>
  {subtitle && <p class="mt-3 max-w-2xl text-slate-600">{subtitle}</p>}
</div>
