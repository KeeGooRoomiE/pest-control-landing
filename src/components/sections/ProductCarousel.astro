---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Card from "../ui/Card.astro";
import Button from "../ui/Button.astro";
import products from "../../data/products.json";

const groceryImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/groceries/*",
  { eager: true },
);
const getImage = (item: (typeof products)[number]) =>
  item.image ? groceryImages[`../../assets/groceries/${item.image}`]?.default : undefined;

const priceFormatter = new Intl.NumberFormat("ru-RU");
const formatPrice = (item: (typeof products)[number]) =>
  `${priceFormatter.format(item.price)} ₸`;

const items = products;

const arrowClass =
  "absolute top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border border-slate-200 bg-white/95 text-slate-700 shadow-md transition-colors hover:bg-white hover:text-brand-green";
---

<section class="py-14">
  <Container>
    <SectionHeading
      eyebrow="Что мы используем"
      title="Продукция, с которой мы работаем"
      subtitle="Витрина оригинальных препаратов и оборудования, применяемых нашими специалистами. Не является каталогом для заказа."
    />

    <div class="relative mt-8" data-carousel>
      <button type="button" class:list={[arrowClass, "left-2"]} data-carousel-prev aria-label="Предыдущие товары">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>
      <button type="button" class:list={[arrowClass, "right-2"]} data-carousel-next aria-label="Следующие товары">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>

      <div class="overflow-x-auto py-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-carousel-viewport>
        <div class="flex w-max select-none gap-4" data-carousel-track>
          {[...items, ...items].map((item) => (
            <Card class="flex w-56 shrink-0 flex-col items-center gap-3 p-5 text-center">
              <div
                role="button"
                tabindex="0"
                aria-haspopup="dialog"
                data-open-modal={item.id}
                class="flex w-full cursor-pointer flex-col items-center gap-3"
              >
                {getImage(item) ? (
                  <Image
                    src={getImage(item)!}
                    alt={item.name}
                    width={224}
                    height={128}
                    draggable="false"
                    class="h-32 w-full rounded-lg object-contain"
                  />
                ) : (
                  <div class="flex h-32 w-full items-center justify-center rounded-lg border-2 border-dashed border-slate-200 text-xs text-slate-400">
                    Фото
                  </div>
                )}
                <p class="text-sm font-semibold text-slate-800">{item.name}</p>
                <p class="text-xs font-medium text-brand-green">{formatPrice(item)}</p>
              </div>
              <Button
                type="button"
                class="mt-auto w-full"
                data-order={item.id}
                data-product-name={item.name}
                data-product-price={formatPrice(item)}
              >
                Заказать
              </Button>
            </Card>
          ))}
        </div>
      </div>
    </div>
  </Container>

  {items.map((item) => (
    <div
      id={`product-modal-${item.id}`}
      class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4"
      data-product-modal
      role="dialog"
      aria-modal="true"
      aria-labelledby={`product-modal-${item.id}-title`}
    >
      <div class="relative flex max-h-[85vh] w-full max-w-3xl flex-col overflow-y-auto rounded-2xl bg-white shadow-xl">
        <button
          type="button"
          class="sticky top-4 z-10 ml-auto mr-4 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-colors hover:bg-slate-200 hover:text-slate-800"
          data-modal-close
          aria-label="Закрыть"
        >
          &#10005;
        </button>

        <div class="grid gap-6 p-6 pt-0 sm:grid-cols-2 sm:p-8 sm:pt-0">
          <div class="flex flex-col items-center gap-3 text-center sm:items-start sm:text-left">
            {getImage(item) ? (
              <Image
                src={getImage(item)!}
                alt={item.name}
                width={400}
                height={300}
                class="h-48 w-full rounded-lg object-contain"
              />
            ) : (
              <div class="flex h-48 w-full items-center justify-center rounded-lg border-2 border-dashed border-slate-200 text-sm text-slate-400">
                Фото
              </div>
            )}
            <p id={`product-modal-${item.id}-title`} class="text-lg font-semibold text-slate-900">
              {item.name}
            </p>
            <p class="text-sm font-medium text-brand-green">{formatPrice(item)}</p>
            <Button
              type="button"
              size="lg"
              class="w-full"
              data-order={item.id}
              data-product-name={item.name}
              data-product-price={formatPrice(item)}
            >
              Заказать
            </Button>
          </div>

          <div class="flex flex-col justify-center gap-3">
            {item.description.split("\n\n").map((paragraph) => (
              <p class="text-sm leading-relaxed text-slate-600">{paragraph}</p>
            ))}
          </div>
        </div>
      </div>
    </div>
  ))}
</section>

<script>
  const ADVANCE_MS = 5500;
  // После ручного действия (стрелки, свайп, перетаскивание) авто-прокрутка молчит столько мс.
  const USER_IDLE_MS = 9000;
  const DRAG_THRESHOLD_PX = 6;

  const isModalOpen = () => document.querySelector("[data-product-modal].flex") !== null;

  function initCarousel(root: HTMLElement) {
    const viewport = root.querySelector<HTMLElement>("[data-carousel-viewport]");
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    if (!viewport || !track) return;

    const cards = Array.from(track.children) as HTMLElement[];
    const half = cards.length / 2;
    // Карточки продублированы (два одинаковых набора), прокрутка зациклена:
    // как только ушли дальше первого набора — незаметно прыгаем на его начало.
    const loopWidth = () => cards[half].offsetLeft - cards[0].offsetLeft;
    const stepWidth = () => cards[1].offsetLeft - cards[0].offsetLeft;

    const normalize = () => {
      const loop = loopWidth();
      if (viewport.scrollLeft >= loop) {
        viewport.scrollTo({ left: viewport.scrollLeft - loop, behavior: "instant" });
      }
    };

    let idleTimer: number | undefined;
    viewport.addEventListener(
      "scroll",
      () => {
        window.clearTimeout(idleTimer);
        idleTimer = window.setTimeout(normalize, 150);
      },
      { passive: true },
    );

    const next = () => {
      normalize();
      viewport.scrollBy({ left: stepWidth(), behavior: "smooth" });
    };
    const prev = () => {
      if (viewport.scrollLeft < stepWidth()) {
        viewport.scrollTo({ left: viewport.scrollLeft + loopWidth(), behavior: "instant" });
      }
      viewport.scrollBy({ left: -stepWidth(), behavior: "smooth" });
    };

    let userActiveUntil = 0;
    let hovered = false;
    const markUserActive = () => {
      userActiveUntil = Date.now() + USER_IDLE_MS;
    };

    root.querySelector("[data-carousel-prev]")?.addEventListener("click", () => {
      markUserActive();
      prev();
    });
    root.querySelector("[data-carousel-next]")?.addEventListener("click", () => {
      markUserActive();
      next();
    });

    root.addEventListener("mouseenter", () => (hovered = true));
    root.addEventListener("mouseleave", () => (hovered = false));
    root.addEventListener("focusin", markUserActive);
    viewport.addEventListener("touchstart", markUserActive, { passive: true });
    viewport.addEventListener("wheel", markUserActive, { passive: true });

    // Перетаскивание мышью (тач и трекпад скроллятся нативно).
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    let moved = 0;

    viewport.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      dragging = true;
      startX = event.clientX;
      startScroll = viewport.scrollLeft;
      moved = 0;
    });
    window.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const dx = event.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      viewport.scrollLeft = startScroll - dx;
      markUserActive();
    });
    window.addEventListener("pointerup", () => {
      dragging = false;
    });
    // Если это было перетаскивание — не считаем отпускание кнопки кликом по карточке.
    viewport.addEventListener(
      "click",
      (event) => {
        if (moved > DRAG_THRESHOLD_PX) {
          event.stopPropagation();
          event.preventDefault();
        }
        moved = 0;
      },
      true,
    );

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    window.setInterval(() => {
      if (hovered || dragging || isModalOpen() || document.hidden) return;
      if (Date.now() < userActiveUntil) return;
      next();
    }, ADVANCE_MS);
  }

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach(initCarousel);

  function openModal(modal: HTMLElement) {
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
    modal.querySelector<HTMLElement>("[data-modal-close]")?.focus();
  }

  function closeModal(modal: HTMLElement) {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLElement>("[data-open-modal]").forEach((trigger) => {
    const id = trigger.dataset.openModal;
    if (!id) return;
    const modal = document.getElementById(`product-modal-${id}`);
    if (!modal) return;

    trigger.addEventListener("click", () => openModal(modal));
    trigger.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        openModal(modal);
      }
    });
  });

  document.querySelectorAll<HTMLElement>("[data-product-modal]").forEach((modal) => {
    modal.addEventListener("click", (event) => {
      if (event.target === modal) closeModal(modal);
    });
    modal.querySelector("[data-modal-close]")?.addEventListener("click", () => closeModal(modal));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    document.querySelectorAll<HTMLElement>("[data-product-modal]").forEach((modal) => {
      if (!modal.classList.contains("hidden")) closeModal(modal);
    });
  });

  // TODO: заказ через бота — подключим сюда. Пока кнопка «Заказать» закрывает модалку,
  // подставляет товар в комментарий формы заявки и прокручивает к форме.
  function handleOrder(button: HTMLElement) {
    const name = button.dataset.productName ?? "";
    const price = button.dataset.productPrice ?? "";

    document.querySelectorAll<HTMLElement>("[data-product-modal]").forEach((modal) => {
      if (!modal.classList.contains("hidden")) closeModal(modal);
    });

    const form = document.querySelector<HTMLFormElement>("[data-lead-form]");
    const comment = form?.querySelector<HTMLTextAreaElement>('textarea[name="comment"]');
    if (comment) comment.value = `Хочу заказать: ${name}${price ? ` (${price})` : ""}`;

    document.getElementById("contacts")?.scrollIntoView({ behavior: "smooth", block: "start" });
    window.setTimeout(() => {
      form?.querySelector<HTMLInputElement>('input[name="name"]')?.focus({ preventScroll: true });
    }, 600);
  }

  document.querySelectorAll<HTMLElement>("[data-order]").forEach((button) => {
    button.addEventListener("click", () => handleOrder(button));
  });
</script>
