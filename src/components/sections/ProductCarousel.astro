---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Card from "../ui/Card.astro";
import products from "../../data/products.json";

const groceryImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/groceries/*",
  { eager: true },
);
const getImage = (item: (typeof products)[number]) =>
  item.image ? groceryImages[`../../assets/groceries/${item.image}`]?.default : undefined;

const priceFormatter = new Intl.NumberFormat("ru-RU");
const formatPrice = (item: (typeof products)[number]) =>
  `${priceFormatter.format(item.price)} ₸`;

const items = products;
---

<section class="py-14">
  <Container>
    <SectionHeading
      eyebrow="Что мы используем"
      title="Продукция, с которой мы работаем"
      subtitle="Витрина оригинальных препаратов и оборудования, применяемых нашими специалистами. Не является каталогом для заказа."
    />

    <div class="relative mt-8 overflow-hidden" data-carousel>
      <div class="flex gap-4" data-carousel-track>
        {[...items, ...items].map((item) => (
          <Card
            class="flex w-56 shrink-0 cursor-pointer flex-col items-center gap-3 p-5 text-center"
            role="button"
            tabindex="0"
            aria-haspopup="dialog"
            data-open-modal={item.id}
          >
            {getImage(item) ? (
              <Image
                src={getImage(item)!}
                alt={item.name}
                width={224}
                height={128}
                class="h-32 w-full rounded-lg object-contain"
              />
            ) : (
              <div class="flex h-32 w-full items-center justify-center rounded-lg border-2 border-dashed border-slate-200 text-xs text-slate-400">
                Фото
              </div>
            )}
            <p class="text-sm font-semibold text-slate-800">{item.name}</p>
            <p class="text-xs font-medium text-brand-green">{formatPrice(item)}</p>
          </Card>
        ))}
      </div>
    </div>
  </Container>

  {items.map((item) => (
    <div
      id={`product-modal-${item.id}`}
      class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/60 p-4"
      data-product-modal
      role="dialog"
      aria-modal="true"
      aria-labelledby={`product-modal-${item.id}-title`}
    >
      <div class="relative flex max-h-[85vh] w-full max-w-3xl flex-col overflow-y-auto rounded-2xl bg-white shadow-xl">
        <button
          type="button"
          class="sticky top-4 z-10 ml-auto mr-4 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-colors hover:bg-slate-200 hover:text-slate-800"
          data-modal-close
          aria-label="Закрыть"
        >
          &#10005;
        </button>

        <div class="grid gap-6 p-6 pt-0 sm:grid-cols-2 sm:p-8 sm:pt-0">
          <div class="flex flex-col items-center gap-3 text-center sm:items-start sm:text-left">
            {getImage(item) ? (
              <Image
                src={getImage(item)!}
                alt={item.name}
                width={400}
                height={300}
                class="h-48 w-full rounded-lg object-contain"
              />
            ) : (
              <div class="flex h-48 w-full items-center justify-center rounded-lg border-2 border-dashed border-slate-200 text-sm text-slate-400">
                Фото
              </div>
            )}
            <p id={`product-modal-${item.id}-title`} class="text-lg font-semibold text-slate-900">
              {item.name}
            </p>
            <p class="text-sm font-medium text-brand-green">{formatPrice(item)}</p>
          </div>

          <div class="flex flex-col justify-center gap-3">
            {item.description.split("\n\n").map((paragraph) => (
              <p class="text-sm leading-relaxed text-slate-600">{paragraph}</p>
            ))}
          </div>
        </div>
      </div>
    </div>
  ))}
</section>

<script>
  const ADVANCE_MS = 5500;

  function initCarousel(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    if (!track) return;

    const cards = Array.from(track.children) as HTMLElement[];
    const half = cards.length / 2;
    let index = 0;

    const step = () => {
      index += 1;
      const card = cards[index];
      if (!card) return;

      track.style.transition = "transform 0.6s ease";
      track.style.transform = `translateX(-${card.offsetLeft}px)`;

      if (index >= half) {
        window.setTimeout(() => {
          track.style.transition = "none";
          index = 0;
          track.style.transform = "translateX(0px)";
        }, 650);
      }
    };

    window.setInterval(step, ADVANCE_MS);
  }

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach(initCarousel);

  function openModal(modal: HTMLElement) {
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
    modal.querySelector<HTMLElement>("[data-modal-close]")?.focus();
  }

  function closeModal(modal: HTMLElement) {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLElement>("[data-open-modal]").forEach((trigger) => {
    const id = trigger.dataset.openModal;
    if (!id) return;
    const modal = document.getElementById(`product-modal-${id}`);
    if (!modal) return;

    trigger.addEventListener("click", () => openModal(modal));
    trigger.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        openModal(modal);
      }
    });
  });

  document.querySelectorAll<HTMLElement>("[data-product-modal]").forEach((modal) => {
    modal.addEventListener("click", (event) => {
      if (event.target === modal) closeModal(modal);
    });
    modal.querySelector("[data-modal-close]")?.addEventListener("click", () => closeModal(modal));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    document.querySelectorAll<HTMLElement>("[data-product-modal]").forEach((modal) => {
      if (!modal.classList.contains("hidden")) closeModal(modal);
    });
  });
</script>
