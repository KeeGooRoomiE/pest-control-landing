---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import products from "../../data/products.json";
import { orderLink } from "../../config/bot";

const groceryImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/groceries/*",
  { eager: true },
);
const getImage = (item: (typeof products)[number]) =>
  item.image ? groceryImages[`../../assets/groceries/${item.image}`]?.default : undefined;

const priceFormatter = new Intl.NumberFormat("ru-RU");
const formatPrice = (item: (typeof products)[number]) =>
  `${priceFormatter.format(item.price)} ₸`;

const items = products;

const arrowClass =
  "absolute top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 sm:h-12 sm:w-12 items-center justify-center rounded-full bg-white text-ink shadow-[0_8px_24px_rgb(15_27_45/0.16)] ring-1 ring-slate-900/5 transition-all duration-200 hover:scale-105 hover:text-brand-green active:scale-95";
---

<section id="products" class="py-20 sm:py-24 lg:py-28">
  <Container>
    <SectionHeading
      eyebrow="Что мы используем"
      title="Продукция, с которой мы работаем"
      subtitle="Витрина оригинальных препаратов и оборудования, применяемых нашими специалистами."
      class="reveal"
    />

    <div class="relative mt-12" data-carousel>
      <button type="button" class:list={[arrowClass, "left-2 sm:left-3"]} data-carousel-prev aria-label="Предыдущие товары">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>
      <button type="button" class:list={[arrowClass, "right-2 sm:right-3"]} data-carousel-next aria-label="Следующие товары">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>

      <div class="-my-8 overflow-x-auto py-8 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-carousel-viewport>
        <div class="flex w-max select-none gap-5" data-carousel-track>
          {[...items, ...items].map((item) => (
            <article class="group flex w-64 shrink-0 flex-col rounded-3xl bg-white p-3 shadow-[0_2px_20px_rgb(15_27_45/0.06)] ring-1 ring-slate-900/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_18px_48px_rgb(15_27_45/0.12)]">
              <div
                role="button"
                tabindex="0"
                aria-haspopup="dialog"
                data-open-modal={item.id}
                class="flex cursor-pointer flex-col"
              >
                <div class="flex h-44 items-center justify-center overflow-hidden rounded-2xl bg-brand-mist p-4">
                  {getImage(item) ? (
                    <Image
                      src={getImage(item)!}
                      alt={item.name}
                      width={480}
                      height={352}
                      draggable="false"
                      class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-105"
                    />
                  ) : (
                    <span class="text-xs text-slate-400">Фото</span>
                  )}
                </div>
                <div class="px-3 pb-2 pt-4">
                  <h3 class="line-clamp-3 min-h-[3.9rem] text-[0.95rem] font-semibold leading-snug text-ink">{item.name}</h3>
                  <p class="mt-2 text-lg font-bold tracking-tight text-brand-green">{formatPrice(item)}</p>
                </div>
              </div>
              <div class="mt-auto px-3 pb-3 pt-1">
                <Button href={orderLink(item.id)} target="_blank" rel="noopener" variant="secondary" class="w-full">
                  Заказать
                </Button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </Container>

  {items.map((item) => (
    <div
      id={`product-modal-${item.id}`}
      class="fixed inset-0 z-[60] hidden items-center justify-center bg-ink/50 p-4 backdrop-blur-sm"
      data-product-modal
      role="dialog"
      aria-modal="true"
      aria-labelledby={`product-modal-${item.id}-title`}
    >
      <div class="modal-in relative flex max-h-[88vh] w-full max-w-4xl flex-col overflow-y-auto rounded-[2rem] bg-white shadow-[0_40px_100px_-20px_rgb(15_27_45/0.5)]">
        <button
          type="button"
          class="sticky top-4 z-10 ml-auto mr-4 mt-4 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-colors hover:bg-slate-200 hover:text-ink"
          data-modal-close
          aria-label="Закрыть"
        >
          &#10005;
        </button>

        <div class="grid gap-8 p-6 pt-2 sm:grid-cols-5 sm:gap-10 sm:p-10 sm:pt-2">
          <div class="flex flex-col gap-5 sm:col-span-2">
            <div class="flex aspect-square items-center justify-center rounded-3xl bg-brand-mist p-6">
              {getImage(item) ? (
                <Image
                  src={getImage(item)!}
                  alt={item.name}
                  width={640}
                  height={640}
                  class="h-full w-full object-contain"
                />
              ) : (
                <span class="text-sm text-slate-400">Фото</span>
              )}
            </div>
            <div>
              <h3 id={`product-modal-${item.id}-title`} class="text-xl font-bold leading-snug tracking-tight text-ink">
                {item.name}
              </h3>
              <p class="mt-2 text-2xl font-bold tracking-tight text-brand-green">{formatPrice(item)}</p>
            </div>
            <Button href={orderLink(item.id)} target="_blank" rel="noopener" size="lg" class="w-full">
              Заказать
            </Button>
          </div>

          <div class="flex flex-col gap-4 text-[0.95rem] leading-relaxed text-slate-600 sm:col-span-3">
            {item.description.split("\n\n").map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
      </div>
    </div>
  ))}
</section>

<script>
  const ADVANCE_MS = 5500;
  // После ручного действия (стрелки, свайп, перетаскивание) авто-прокрутка молчит столько мс.
  const USER_IDLE_MS = 9000;
  const DRAG_THRESHOLD_PX = 6;

  const isModalOpen = () => document.querySelector("[data-product-modal].flex") !== null;

  function initCarousel(root: HTMLElement) {
    const viewport = root.querySelector<HTMLElement>("[data-carousel-viewport]");
    const track = root.querySelector<HTMLElement>("[data-carousel-track]");
    if (!viewport || !track) return;

    const cards = Array.from(track.children) as HTMLElement[];
    const half = cards.length / 2;
    // Карточки продублированы (два одинаковых набора), прокрутка зациклена:
    // как только ушли дальше первого набора — незаметно прыгаем на его начало.
    const loopWidth = () => cards[half].offsetLeft - cards[0].offsetLeft;
    const stepWidth = () => cards[1].offsetLeft - cards[0].offsetLeft;

    const normalize = () => {
      const loop = loopWidth();
      if (viewport.scrollLeft >= loop) {
        viewport.scrollTo({ left: viewport.scrollLeft - loop, behavior: "instant" });
      }
    };

    let idleTimer: number | undefined;
    viewport.addEventListener(
      "scroll",
      () => {
        window.clearTimeout(idleTimer);
        idleTimer = window.setTimeout(normalize, 150);
      },
      { passive: true },
    );

    const next = () => {
      normalize();
      viewport.scrollBy({ left: stepWidth(), behavior: "smooth" });
    };
    const prev = () => {
      if (viewport.scrollLeft < stepWidth()) {
        viewport.scrollTo({ left: viewport.scrollLeft + loopWidth(), behavior: "instant" });
      }
      viewport.scrollBy({ left: -stepWidth(), behavior: "smooth" });
    };

    let userActiveUntil = 0;
    let hovered = false;
    const markUserActive = () => {
      userActiveUntil = Date.now() + USER_IDLE_MS;
    };

    root.querySelector("[data-carousel-prev]")?.addEventListener("click", () => {
      markUserActive();
      prev();
    });
    root.querySelector("[data-carousel-next]")?.addEventListener("click", () => {
      markUserActive();
      next();
    });

    root.addEventListener("mouseenter", () => (hovered = true));
    root.addEventListener("mouseleave", () => (hovered = false));
    root.addEventListener("focusin", markUserActive);
    viewport.addEventListener("touchstart", markUserActive, { passive: true });
    viewport.addEventListener("wheel", markUserActive, { passive: true });

    // Перетаскивание мышью (тач и трекпад скроллятся нативно).
    let dragging = false;
    let startX = 0;
    let startScroll = 0;
    let moved = 0;

    viewport.addEventListener("pointerdown", (event) => {
      if (event.pointerType !== "mouse" || event.button !== 0) return;
      dragging = true;
      startX = event.clientX;
      startScroll = viewport.scrollLeft;
      moved = 0;
    });
    window.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const dx = event.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      viewport.scrollLeft = startScroll - dx;
      markUserActive();
    });
    window.addEventListener("pointerup", () => {
      dragging = false;
    });
    // Если это было перетаскивание — не считаем отпускание кнопки кликом по карточке.
    viewport.addEventListener(
      "click",
      (event) => {
        if (moved > DRAG_THRESHOLD_PX) {
          event.stopPropagation();
          event.preventDefault();
        }
        moved = 0;
      },
      true,
    );

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    window.setInterval(() => {
      if (hovered || dragging || isModalOpen() || document.hidden) return;
      if (Date.now() < userActiveUntil) return;
      next();
    }, ADVANCE_MS);
  }

  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach(initCarousel);

  function openModal(modal: HTMLElement) {
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
    modal.querySelector<HTMLElement>("[data-modal-close]")?.focus();
  }

  function closeModal(modal: HTMLElement) {
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  document.querySelectorAll<HTMLElement>("[data-open-modal]").forEach((trigger) => {
    const id = trigger.dataset.openModal;
    if (!id) return;
    const modal = document.getElementById(`product-modal-${id}`);
    if (!modal) return;

    trigger.addEventListener("click", () => openModal(modal));
    trigger.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        openModal(modal);
      }
    });
  });

  document.querySelectorAll<HTMLElement>("[data-product-modal]").forEach((modal) => {
    modal.addEventListener("click", (event) => {
      if (event.target === modal) closeModal(modal);
    });
    modal.querySelector("[data-modal-close]")?.addEventListener("click", () => closeModal(modal));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    document.querySelectorAll<HTMLElement>("[data-product-modal]").forEach((modal) => {
      if (!modal.classList.contains("hidden")) closeModal(modal);
    });
  });
</script>
