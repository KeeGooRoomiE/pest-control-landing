---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import { site, navLinks } from "../../data/site";
import logo from "../../assets/logo/qaz-pest-control.jpg";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-white py-12">
  <Container>
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-sm">
        <a href="#hero" class="flex items-center gap-3">
          <Image src={logo} alt={site.companyName} width={44} height={44} class="h-11 w-11 rounded-lg object-contain" />
          <span class="text-lg font-bold tracking-tight text-ink">{site.companyName}</span>
        </a>
        <p class="mt-3 text-sm leading-relaxed text-slate-500">{site.tagline}</p>
      </div>

      <nav aria-label="Навигация по сайту">
        <ul class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-medium text-slate-600">
          {navLinks.map((link) => (
            <li><a href={link.href} class="transition-colors hover:text-brand-green">{link.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <p class="mt-10 border-t border-slate-200 pt-6 text-sm text-slate-400">
      &copy; {currentYear} {site.legalName}. Все права защищены.
    </p>
  </Container>
</footer>
