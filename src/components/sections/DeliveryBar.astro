---
import Container from "../ui/Container.astro";

const items = [
  { title: "Быстрая доставка", hint: "По всему Казахстану" },
  { title: "Оригинальная продукция", hint: "Гарантия качества" },
  { title: "Поддержка специалистов", hint: "Подбор и консультация" },
  { title: "Удобная оплата", hint: "Для юр. и физ. лиц" },
];
---

<section id="delivery" class="bg-brand-navy py-8 text-white">
  <Container class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {items.map((item) => (
      <div class="flex items-center gap-3">
        <svg class="h-8 w-8 shrink-0 text-white/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="4" />
        </svg>
        <div>
          <p class="font-semibold leading-tight">{item.title}</p>
          <p class="text-sm text-white/60">{item.hint}</p>
        </div>
      </div>
    ))}
  </Container>
</section>
