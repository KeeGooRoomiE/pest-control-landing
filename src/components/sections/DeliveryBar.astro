---
import Container from "../ui/Container.astro";

// Иконки — Lucide (MIT), цвет наследуется через currentColor.
// Блок выводится внутри Hero (см. Hero.astro), якорь #delivery — для меню.
const items = [
  {
    title: "Быстрая доставка",
    hint: "По всему Казахстану",
    icon: `<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" /><path d="M15 18H9" /><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" /><circle cx="17" cy="18" r="2" /><circle cx="7" cy="18" r="2" />`,
  },
  {
    title: "Оригинальная продукция",
    hint: "Гарантия качества",
    icon: `<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z" /><path d="m16 9-5.5 5.5L8 12" />`,
  },
  {
    title: "Поддержка специалистов",
    hint: "Подбор и консультация",
    icon: `<circle cx="12" cy="12" r="10" /><path d="m4.93 4.93 4.24 4.24" /><path d="m14.83 9.17 4.24-4.24" /><path d="m14.83 14.83 4.24 4.24" /><path d="m9.17 14.83-4.24 4.24" /><circle cx="12" cy="12" r="4" />`,
  },
  {
    title: "Удобная оплата",
    hint: "Для юр. и физ. лиц",
    icon: `<rect width="20" height="14" x="2" y="5" rx="2" /><line x1="2" x2="22" y1="10" y2="10" />`,
  },
];
---

<div id="delivery">
  <Container class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {items.map((item, i) => (
      <div
        class="reveal group flex items-center gap-4 rounded-2xl bg-white p-5 shadow-[0_2px_20px_rgb(15_27_45/0.06)] ring-1 ring-slate-900/5 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_36px_rgb(15_27_45/0.1)]"
        style={`--reveal-delay: ${i * 90}ms`}
      >
        <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-green/10 text-brand-green transition-colors duration-300 group-hover:bg-brand-green group-hover:text-white">
          <svg
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={item.icon}
          />
        </span>
        <div>
          <p class="font-semibold leading-tight text-ink">{item.title}</p>
          <p class="mt-1 text-sm text-slate-500">{item.hint}</p>
        </div>
      </div>
    ))}
  </Container>
</div>
