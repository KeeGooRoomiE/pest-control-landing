---
import Button from "../ui/Button.astro";
import { site, navLinks } from "../../data/site";

// Файлы из public/ адресуем с учётом `base` (см. astro.config.mjs).
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Якоря ведут на главную: так меню работает и на других страницах (например, 404).
const home = `${base}/`;
---

<header class="fixed inset-x-0 top-0 z-50" data-header>
  <div
    class="bg-brand-green/95 text-white shadow-[0_1px_0_rgb(255_255_255/0.1)] backdrop-blur-xl transition-shadow duration-300 data-[scrolled=true]:shadow-[0_10px_30px_rgb(11_22_38/0.3)]"
    data-header-bar
  >
    <div class="relative mx-auto flex w-full max-w-[96rem] items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-10">
      <a href={home} class="flex shrink-0 items-center gap-3">
        <img
          src={`${base}/icon-192.png`}
          alt=""
          width="44"
          height="44"
          class="h-11 w-11 rounded-xl shadow-sm ring-1 ring-black/5"
        />
        <span class="text-base font-bold tracking-tight sm:text-lg">{site.companyName}</span>
      </a>

      <nav class="hidden items-center gap-1 whitespace-nowrap text-sm font-medium text-white/90 xl:flex">
        {navLinks.map((link) => (
          <a href={`${home}${link.href}`} class="rounded-lg px-3.5 py-2 transition-colors hover:bg-white/15 hover:text-white">
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2 sm:gap-4">
        <a href={site.phoneHref} class="hidden whitespace-nowrap text-sm font-bold transition-opacity hover:opacity-80 md:block">
          {site.phone}
        </a>
        <div class="hidden sm:block">
          <Button href={`${home}#contacts`} variant="secondary" size="md">Получить консультацию</Button>
        </div>

        <a
          href={site.phoneHref}
          class="flex h-10 w-10 items-center justify-center rounded-xl bg-white text-brand-green sm:hidden"
          aria-label={`Позвонить ${site.phone}`}
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
          </svg>
        </a>

        <button
          type="button"
          class="flex h-10 w-10 items-center justify-center rounded-xl text-white ring-1 ring-white/40 transition-colors hover:bg-white/15 xl:hidden"
          aria-label="Открыть меню"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path data-menu-icon-open d="M4 7h16M4 12h16M4 17h16" />
            <path data-menu-icon-close class="hidden" d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
      </div>

      <div
        id="mobile-menu"
        class="absolute inset-x-3 top-full mt-2 hidden rounded-2xl bg-white p-3 text-slate-700 shadow-[0_16px_50px_rgb(15_27_45/0.22)] ring-1 ring-slate-900/5 sm:inset-x-6 xl:hidden"
        data-menu-panel
      >
        <nav class="grid gap-1 text-base font-medium">
          {navLinks.map((link) => (
            <a href={`${home}${link.href}`} class="rounded-xl px-4 py-3 transition-colors hover:bg-brand-green/10 hover:text-brand-green" data-menu-link>
              {link.label}
            </a>
          ))}
        </nav>
        <Button href={`${home}#contacts`} size="lg" class="mt-3 w-full" data-menu-link>Получить консультацию</Button>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const bar = header?.querySelector<HTMLElement>("[data-header-bar]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = header?.querySelector<HTMLElement>("[data-menu-panel]");
  const iconOpen = header?.querySelector("[data-menu-icon-open]");
  const iconClose = header?.querySelector("[data-menu-icon-close]");

  const setOpen = (open: boolean) => {
    if (!toggle || !panel) return;
    panel.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Закрыть меню" : "Открыть меню");
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
  };

  toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
  header?.querySelectorAll("[data-menu-link]").forEach((link) => link.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setOpen(false);
  });
  document.addEventListener("click", (event) => {
    if (header && !header.contains(event.target as Node)) setOpen(false);
  });
  window.matchMedia("(min-width: 1280px)").addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });

  const onScroll = () => bar?.setAttribute("data-scrolled", String(window.scrollY > 8));
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>
