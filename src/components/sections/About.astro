---
import Container from "../ui/Container.astro";
import { site } from "../../data/site";

// Иконки — Lucide (MIT), цвет наследуется через currentColor.
const trustPoints = [
  {
    label: "Опытные специалисты",
    icon: `<path d="m16 11 2 2 4-4" /><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />`,
  },
  {
    label: "Сертифицированные препараты",
    icon: `<path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526" /><circle cx="12" cy="8" r="6" />`,
  },
  {
    label: "Индивидуальный подход",
    icon: `<path d="m11 17 2 2a1 1 0 1 0 3-3" /><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" /><path d="m21 3 1 11h-2" /><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" /><path d="M3 4h8" />`,
  },
  {
    label: "Конфиденциальность гарантирована",
    icon: `<rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />`,
  },
  {
    label: "Гарантия на работы",
    icon: `<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" /><path d="M14 2v5a1 1 0 0 0 1 1h5" /><path d="m9 15 2 2 4-4" />`,
  },
];
---

<section id="about" class="py-20 sm:py-24 lg:py-28">
  <Container class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
    <div class="lg:col-span-5">
      <p class="reveal text-sm font-semibold uppercase tracking-[0.14em] text-brand-green">О компании</p>
      <h2
        class="reveal mt-3 text-3xl font-bold leading-tight tracking-tight text-ink sm:text-4xl"
        style="--reveal-delay: 80ms"
      >
        {site.legalName}{site.sinceYear ? ` — на рынке с ${site.sinceYear} года` : ""}
      </h2>
      <p class="reveal mt-6 text-lg leading-relaxed text-slate-600" style="--reveal-delay: 160ms">
        Работаем с собственной профессиональной химией и приложим все усилия, чтобы решить вашу проблему
        с вредителями. Гарантируем позитивный опыт сотрудничества.
      </p>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-7 lg:grid-cols-1 xl:grid-cols-2">
      {trustPoints.map((point, i) => (
        <li
          class:list={[
            "reveal group flex items-center gap-4 rounded-3xl bg-brand-mist p-5 ring-1 ring-slate-900/5 transition-colors duration-300 hover:bg-white hover:shadow-[0_14px_40px_rgb(15_27_45/0.08)] sm:p-6",
            i === trustPoints.length - 1 && trustPoints.length % 2 === 1 && "sm:col-span-2 lg:col-span-1 xl:col-span-2",
          ]}
          style={`--reveal-delay: ${i * 80}ms`}
        >
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white text-brand-green shadow-sm ring-1 ring-slate-900/5 transition-colors duration-300 group-hover:bg-brand-green group-hover:text-white">
            <svg
              class="h-6 w-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={point.icon}
            />
          </span>
          <span class="font-semibold leading-snug text-ink">{point.label}</span>
        </li>
      ))}
    </ul>
  </Container>
</section>
