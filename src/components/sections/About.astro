---
import Container from "../ui/Container.astro";
import IconTile from "../ui/IconTile.astro";
import { site } from "../../data/site";

// Иконки — Lucide (MIT), цвет наследуется через currentColor (IconTile: text-brand-green).
const trustPoints = [
  {
    label: "Опытные специалисты",
    icon: `<path d="m16 11 2 2 4-4" /><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" />`,
  },
  {
    label: "Сертифицированные препараты",
    icon: `<path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526" /><circle cx="12" cy="8" r="6" />`,
  },
  {
    label: "Индивидуальный подход",
    icon: `<path d="m11 17 2 2a1 1 0 1 0 3-3" /><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" /><path d="m21 3 1 11h-2" /><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" /><path d="M3 4h8" />`,
  },
  {
    label: "Конфиденциальность гарантирована",
    icon: `<rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />`,
  },
  {
    label: "Гарантия на работы",
    icon: `<path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" /><path d="M14 2v5a1 1 0 0 0 1 1h5" /><path d="m9 15 2 2 4-4" />`,
  },
];
---

<section id="about" class="py-14">
  <Container>
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-green">О компании</p>
      <h2 class="mt-2 text-2xl font-bold text-slate-900 sm:text-3xl">
        {site.legalName} — на рынке с {site.sinceYear} года
      </h2>
      <p class="mt-4 text-slate-600">
        Работаем с собственной профессиональной химией и приложим все усилия, чтобы решить вашу проблему
        с вредителями. Гарантируем позитивный опыт сотрудничества.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-8 sm:grid-cols-5">
      {trustPoints.map((point) => (
        <IconTile label={point.label}>
          <svg
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={point.icon}
          />
        </IconTile>
      ))}
    </div>
  </Container>
</section>
