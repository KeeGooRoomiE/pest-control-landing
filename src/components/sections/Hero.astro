---
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import CheckItem from "../ui/CheckItem.astro";

const features = [
  "Эффективность, проверенная временем",
  "Безопасность при правильном применении",
  "Широкий ассортимент для любых задач",
  "Профессиональное качество от ведущих брендов",
];
---

<section id="hero" class="bg-brand-gray">
  <Container class="grid gap-10 py-14 lg:grid-cols-2 lg:items-center lg:py-20">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-green">
        Профессиональные средства для дезинсекции
      </p>
      <h1 class="mt-3 text-3xl font-extrabold leading-tight text-slate-900 sm:text-4xl lg:text-5xl">
        Защита от вредителей для специалистов и требовательных клиентов
      </h1>
      <ul class="mt-6 space-y-3 text-slate-700">
        {features.map((f) => <CheckItem>{f}</CheckItem>)}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="#categories" size="lg">Перейти в каталог</Button>
        <Button href="#contacts" variant="secondary" size="lg">Получить консультацию</Button>
      </div>
    </div>

    <div class="relative">
      <!-- TODO: заменить на фото товаров клиента, см. .claude/ASSETS.md -->
      <div class="flex aspect-[4/3] w-full items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 bg-white text-slate-400">
        Изображение товаров (заглушка)
      </div>
    </div>
  </Container>
</section>
