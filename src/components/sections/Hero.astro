---
import { Image } from "astro:assets";
import Container from "../ui/Container.astro";
import Button from "../ui/Button.astro";
import DeliveryBar from "./DeliveryBar.astro";
import productsLineup from "../../assets/hero/products-lineup.jpg";

const features = [
  "Эффективность, проверенная временем",
  "Безопасность при правильном применении",
  "Широкий ассортимент для любых задач",
  "Профессиональное качество от ведущих брендов",
];
---

<section id="hero" class="relative overflow-hidden bg-gradient-to-b from-brand-mist to-white pb-16 pt-28 sm:pt-32 lg:pb-24 lg:pt-40">
  <div class="pointer-events-none absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-brand-green/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-48 top-1/2 h-[26rem] w-[26rem] rounded-full bg-emerald-300/10 blur-3xl" aria-hidden="true"></div>

  <Container class="relative grid items-center gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-6">
      <p class="reveal inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 text-sm font-semibold text-brand-green shadow-sm ring-1 ring-brand-green/15">
        <span class="h-2 w-2 rounded-full bg-brand-green" aria-hidden="true"></span>
        Профессиональные средства для дезинсекции
      </p>
      <h1
        class="reveal mt-6 text-4xl font-bold leading-[1.08] tracking-tight text-ink sm:text-5xl lg:text-[3.5rem]"
        style="--reveal-delay: 80ms"
      >
        Защита от <span class="text-brand-green">вредителей</span> для специалистов и требовательных клиентов
      </h1>
      <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-slate-600" style="--reveal-delay: 160ms">
        Работаем с собственной профессиональной химией и приложим все усилия, чтобы решить вашу проблему с вредителями.
      </p>
      <div class="reveal mt-9 flex flex-wrap gap-3" style="--reveal-delay: 240ms">
        <Button href="#products" size="lg" class="w-full sm:w-auto">Перейти в каталог</Button>
        <Button href="#contacts" variant="secondary" size="lg" class="w-full sm:w-auto">Получить консультацию</Button>
      </div>
      <ul class="reveal mt-10 grid gap-x-6 gap-y-3 text-sm text-slate-600 sm:grid-cols-2" style="--reveal-delay: 320ms">
        {features.map((f) => (
          <li class="flex items-start gap-2.5">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand-green" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.86-9.64a.75.75 0 0 0-1.22-.88l-3.24 4.5-1.9-1.9a.75.75 0 0 0-1.06 1.06l2.5 2.5a.75.75 0 0 0 1.14-.1l3.78-5.18Z" clip-rule="evenodd"></path>
            </svg>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="relative lg:col-span-6">
      <div class="absolute -bottom-5 -left-5 hidden h-3/4 w-3/4 rounded-[2rem] bg-brand-green/10 sm:block" aria-hidden="true"></div>
      <div class="relative overflow-hidden rounded-[2rem] shadow-[0_30px_80px_-20px_rgb(15_27_45/0.35)] ring-1 ring-slate-900/5">
        <Image
          src={productsLineup}
          alt="Линейка продукции QAZ Pest Control"
          width={1280}
          height={918}
          loading="eager"
          fetchpriority="high"
          class="hero-image-in aspect-[4/3] w-full object-cover"
        />
      </div>
    </div>
  </Container>

  <div class="relative mt-16 lg:mt-20">
    <DeliveryBar />
  </div>
</section>
