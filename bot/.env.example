# Скопируйте в bot/.env (файл в .gitignore) и заполните. Секреты в репозиторий не коммитить.

# Токен бота от @BotFather
BOT_TOKEN=
# ID группы заказов (отрицательное число, у супергрупп вида -100...)
ORDERS_CHAT_ID=

# Необязательно:
# URL или путь к products.json (по умолчанию — raw GitHub репозитория сайта)
# PRODUCTS_SOURCE=
# Ссылка на сайт для приветствия бота
# SITE_URL=
# Телефон, который бот покажет клиенту, если заявку не удалось отправить
# CONTACT_PHONE=
# LOG_LEVEL=INFO
